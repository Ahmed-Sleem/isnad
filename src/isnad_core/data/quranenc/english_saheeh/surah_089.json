e\u0670\u0646\u064e\u0646\u0650","translation":"But when He tries him and restricts his provision, he says, \"My Lord has humiliated me.\"","footnotes":""},{"id":"6010","sura":"89","aya":"17","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644 \u0644\u0651\u064e\u0627 \u062a\u064f\u0643\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u064a\u064e\u062a\u0650\u064a\u0645\u064e","translation":"No![1919] But you do not honor the orphan","footnotes":"[1919] It is not like you imagine. Rather, All\u0101h tries people through prosperity and hardship and rewards both gratitude and patience with honor in the Hereafter."},{"id":"6011","sura":"89","aya":"18","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u062d\u064e\u0670\u0653\u0636\u0651\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0637\u064e\u0639\u064e\u0627\u0645\u0650 \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u0650","translation":"And you do not encourage one another to feed the poor.","footnotes":""},{"id":"6012","sura":"89","aya":"19","arabic_text":"\u0648\u064e\u062a\u064e\u0623\u06e1\u0643\u064f\u0644\u064f\u0648\u0646\u064e \u0671\u0644\u062a\u0651\u064f\u0631\u064e\u0627\u062b\u064e \u0623\u064e\u0643\u06e1\u0644\u0657\u0627 \u0644\u0651\u064e\u0645\u0651\u0657\u0627","translation":"And you consume inheritance, devouring [it] altogether,[1920]","footnotes":"[1920] Not caring whether it is lawful or unlawful."},{"id":"6013","sura":"89","aya":"20","arabic_text":"\u0648\u064e\u062a\u064f\u062d\u0650\u0628\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064e\u0627\u0644\u064e \u062d\u064f\u0628\u0651\u0657\u0627 \u062c\u064e\u0645\u0651\u0657\u0627","translation":"And you love wealth with immense love.","footnotes":""},{"id":"6014","sura":"89","aya":"21","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0630\u064e\u0627 \u062f\u064f\u0643\u0651\u064e\u062a\u0650 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064f \u062f\u064e\u0643\u0651\u0657\u0627 \u062f\u064e\u0643\u0651\u0657\u0627","translation":"No! When the earth has been leveled - pounded and crushed","footnotes":""},{"id":"6015","sura":"89","aya":"22","arabic_text":"\u0648\u064e\u062c\u064e\u0627\u0653\u0621\u064e \u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0643\u064f \u0635\u064e\u0641\u0651\u0657\u0627 \u0635\u064e\u0641\u0651\u0657\u0627","translation":"And your Lord has come[1921] and the angels, rank upon rank,","footnotes":"[1921] To pass judgement. See footnote to 2:19."},{"id":"6016","sura":"89","aya":"23","arabic_text":"\u0648\u064e\u062c\u0650\u0627\u0652\u064a\u0653\u0621\u064e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0650\u06ed \u0628\u0650\u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e\u06da \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u064a\u064e\u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0649\u0670 \u0644\u064e\u0647\u064f \u0671\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u064e\u0649\u0670","translation":"And brought [within view], that Day, is Hell - that Day, man will remember, but how [i.e., what good] to him will be the remembrance?","footnotes":""},{"id":"6017","sura":"89","aya":"24","arabic_text":"\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0646\u0650\u064a \u0642\u064e\u062f\u0651\u064e\u0645\u06e1\u062a\u064f \u0644\u0650\u062d\u064e\u064a\u064e\u0627\u062a\u0650\u064a","translation":"He will say, \"Oh, I wish I had sent ahead [some good] for my life.\"[1922]","footnotes":"[1922] The everlasting life of the Hereafter."},{"id":"6018","sura":"89","aya":"25","arabic_text":"\u0641\u064e\u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u064e\u0627 \u064a\u064f\u0639\u064e\u0630\u