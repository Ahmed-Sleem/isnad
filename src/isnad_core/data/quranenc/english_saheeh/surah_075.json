_text":"\u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u062c\u064e\u0645\u06e1\u0639\u064e\u0647\u064f\u06e5 \u0648\u064e\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e\u0647\u064f\u06e5","translation":"Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation.","footnotes":""},{"id":"5569","sura":"75","aya":"18","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064e\u0631\u064e\u0623\u06e1\u0646\u064e\u0670\u0647\u064f \u0641\u064e\u0671\u062a\u0651\u064e\u0628\u0650\u0639\u06e1 \u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e\u0647\u064f\u06e5","translation":"So when We have recited it [through Gabriel], then follow its recitation.","footnotes":""},{"id":"5570","sura":"75","aya":"19","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0628\u064e\u064a\u064e\u0627\u0646\u064e\u0647\u064f\u06e5","translation":"Then upon Us is its clarification [to you].","footnotes":""},{"id":"5571","sura":"75","aya":"20","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0628\u064e\u0644\u06e1 \u062a\u064f\u062d\u0650\u0628\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0639\u064e\u0627\u062c\u0650\u0644\u064e\u0629\u064e","translation":"No! But you [i.e., mankind] love the immediate","footnotes":""},{"id":"5572","sura":"75","aya":"21","arabic_text":"\u0648\u064e\u062a\u064e\u0630\u064e\u0631\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e","translation":"And leave [i.e., neglect] the Hereafter.","footnotes":""},{"id":"5573","sura":"75","aya":"22","arabic_text":"\u0648\u064f\u062c\u064f\u0648\u0647\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0646\u0651\u064e\u0627\u0636\u0650\u0631\u064e\u0629\u064c","translation":"[Some] faces, that Day, will be radiant,","footnotes":""},{"id":"5574","sura":"75","aya":"23","arabic_text":"\u0625\u0