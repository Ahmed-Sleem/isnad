ya":"28","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4930","sura":"55","aya":"29","arabic_text":"\u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0647\u064f\u06e5 \u0645\u064e\u0646 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650\u06da \u0643\u064f\u0644\u0651\u064e \u064a\u064e\u0648\u06e1\u0645\u064d \u0647\u064f\u0648\u064e \u0641\u0650\u064a \u0634\u064e\u0623\u06e1\u0646\u0656","translation":"Whoever is within the heavens and earth asks Him; every day He is in [i.e., bringing about] a matter.[1598]","footnotes":"[1598] For each of His creatures."},{"id":"4931","sura":"55","aya":"30","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4932","sura":"55","aya":"31","arabic_text":"\u0633\u064e\u0646\u064e\u0641\u06e1\u0631\u064f\u063a\u064f \u0644\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064e \u0671\u0644\u062b\u0651\u064e\u0642\u064e\u0644\u064e\u0627\u0646\u0650","translation":"We will attend to you, O prominent beings.[1599]","footnotes":"[1599] Specifically two: mankind and jinn."},{"id":"4933","sura":"55","aya":"32","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4934","sura":"55","aya":"33","arabic_text":"\u064a\u064e\u0670\u0645\u064e\u0639\u06e1\u0634\u064e\u0631\u064e \u0671\u0644\u06e1\u062c\u0650\u0646\u0651\u0650 \u0648\u064e\u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u0650 \u0625\u0650\u0646\u0650 \u0671\u0633\u06e1\u062a\u064e\u0637\u064e\u0639\u06e1\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646 \u062a\u064e\u0646\u0641\u064f\u0630\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u06e1 \u0623\u064e\u0642\u06e1\u0637\u064e\u0627\u0631\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0641\u064e\u0671\u0646\u0641\u064f\u0630\u064f\u0648\u0627\u0652\u06da \u0644\u064e\u0627 \u062a\u064e\u0646\u0641\u064f\u0630\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u0656","translation":"O company of jinn and mankind, if you are able to pass beyond the regions of the heavens and the earth, then pass. You will not pass except by authority [from All\u0101h].","footnotes":""},{"id":"4935","sura":"55","aya":"34","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4936","sura":"55","aya":"35","arabic_text":"\u064a\u064f\u0631\u06e1\u0633\u064e\u0644\u064f \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u064e\u0627 \u0634\u064f\u0648\u064e\u0627\u0638\u065e \u0645\u0651\u0650\u0646 \u0646\u0651\u064e\u0627\u0631\u0656 \u0648\u064e\u0646\u064f\u062d\u064e\u0627\u0633\u065e \u0641\u064e\u0644\u064e\u0627 \u062a\u064e\u0646\u062a\u064e\u0635\u0650\u0631\u064e\u0627\u0646\u0650","translation":"There will be sent upon you a flame of fire and smoke,[1600] and you will not defend yourselves.","footnotes":"[1600] Another possible meaning is liquefied brass or copper."},{"id":"4937","sura":"55","aya":"36","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4938","sura":"55","aya":"37","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0646\u0634\u064e\u0642\u0651\u064e\u062a\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0641\u064e\u0643\u064e\u0627\u0646\u064e\u062a\u06e1 \u0648\u064e\u0631\u06e1\u062f\u064e\u0629\u0657 \u0643\u064e\u0671\u0644\u062f\u0651\u0650\u0647\u064e\u0627\u0646\u0650","translation":"And when the heaven is split open and becomes rose-colored like oil[1601] -","footnotes":"[1601] Or \"like a tanned skin.\""},{"id":"4939","sura":"55","aya":"38","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny? -","footnotes":""},{"id":"4940","sura":"55","aya":"39","arabic_text":"\u0641\u064e\u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u064e\u0627 \u064a\u064f\u0633\u06e1\u0640\u0654\u064e\u0644\u064f \u0639\u064e\u0646 \u0630\u064e\u0646\u06e2\u0628\u0650\u0647\u0650\u06e6\u0653 \u0625\u0650\u0646\u0633\u065e \u0648\u064e\u0644\u064e\u0627 \u062c\u064e\u0627\u0653\u0646\u0651\u065e","translation":"Then on that Day none will be asked about his sin among men or jinn.[1602]","footnotes":"[1602] Once they have been condemned to the Fire."},{"id":"4941","sura":"55","aya":"40","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4942","sura":"55","aya":"41","arabic_text":"\u064a\u064f\u0639\u06e1\u0631\u064e\u0641\u064f \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e \u0628\u0650\u0633\u0650\u064a\u0645\u064e\u0670\u0647\u064f\u0645\u06e1 \u0641\u064e\u064a\u064f\u0624\u06e1\u062e\u064e\u0630\u064f \u0628\u0650\u0671\u0644\u0646\u0651\u064e\u0648\u064e\u0670\u0635\u0650\u064a \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0642\u06e1\u062f\u064e\u0627\u0645\u0650","translation":"The criminals will be known by their marks, and they will be seized by the forelocks and the feet.","footnotes":""},{"id":"4943","sura":"55","aya":"42","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4944","sura":"55","aya":"43","arabic_text":"\u0647\u064e\u0670\u0630\u0650\u0647\u0650\u06e6 \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064f \u0671\u0644\u0651\u064e\u062a\u0650\u064a \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u0647\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e","translation":"This is Hell, which the criminals deny.","footnotes":""},{"id":"4945","sura":"55","aya":"44","arabic_text":"\u064a\u064e\u0637\u064f\u0648\u0641\u064f\u0648\u0646\u064e \u0628\u064e\u064a\u06e1\u0646\u064e\u0647\u064e\u0627 \u0648\u064e\u0628\u064e\u064a\u06e1\u0646\u064e \u062d\u064e\u0645\u0650\u064a\u0645\u064d \u0621\u064e\u0627\u0646\u0656","translation":"They will circulate between it and scalding water, heated [to the utmost degree].","footnotes":""},{"id":"4946","sura":"55","aya":"45","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4947","sura":"55","aya":"46","arabic_text":"\u0648\u064e\u0644\u0650\u0645\u064e\u0646\u06e1 \u062e\u064e\u0627\u0641\u064e \u0645\u064e\u0642\u064e\u0627\u0645\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u062c\u064e\u0646\u0651\u064e\u062a\u064e\u0627\u0646\u0650","translation":"But for he who has feared the position of his Lord[1603] are two gardens -","footnotes":"[1603] An alternative meaning is \"the standing [for account] before his Lord.\""},{"id":"4948","sura":"55","aya":"47","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny? -","footnotes":""},{"id":"4949","sura":"55","aya":"48","arabic_text":"\u0630\u064e\u0648\u064e\u0627\u062a\u064e\u0627\u0653 \u0623\u064e\u0641\u06e1\u0646\u064e\u0627\u0646\u0656","translation":"Having [spreading] branches.","footnotes":""},{"id":"4950","sura":"55","aya":"49","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4951","sura":"55","aya":"50","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0645\u064e\u0627 \u0639\u064e\u064a\u06e1\u0646\u064e\u0627\u0646\u0650 \u062a\u064e\u062c\u06e1\u0631\u0650\u064a\u064e\u0627\u0646\u0650","translation":"In both of them are two springs, flowing.","footnotes":""},{"id":"4952","sura":"55","aya":"51","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4953","sura":"55","aya":"52","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0645\u064e\u0627 \u0645\u0650\u0646 \u0643\u064f\u0644\u0651\u0650 \u0641\u064e\u0670\u0643\u0650\u0647\u064e\u0629\u0656 \u0632\u064e\u0648\u06e1\u062c\u064e\u0627\u0646\u0650","translation":"In both of them are of every fruit, two kinds.","footnotes":""},{"id":"4954","sura":"55","aya":"53","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4955","sura":"55","aya":"54","arabic_text":"\u0645\u064f\u062a\u0651\u064e\u0643\u0650\u0640\u0654\u0650\u064a\u0646\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0641\u064f\u0631\u064f\u0634\u0650\u06ed \u0628\u064e\u0637\u064e\u0627\u0653\u0626\u0650\u0646\u064f\u0647\u064e\u0627 \u0645\u0650\u0646\u06e1 \u0625\u0650\u0633\u06e1\u062a\u064e\u0628\u06e1\u0631\u064e\u0642\u0656\u06da \u0648\u064e\u062c\u064e\u0646\u064e\u0649 \u0671\u0644\u06e1\u062c\u064e\u0646\u0651\u064e\u062a\u064e\u064a\u06e1\u0646\u0650 \u062f\u064e\u0627\u0646\u0656","translation":"[They are] reclining on beds whose linings are of silk brocade, and the fruit of the two gardens is hanging low.","footnotes":""},{"id":"4956","sura":"55","aya":"55","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4957","sura":"55","aya":"56","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0646\u0651\u064e \u0642\u064e\u0670\u0635\u0650\u0631\u064e\u0670\u062a\u064f \u0671\u0644\u0637\u0651\u064e\u0631\u06e1\u0641\u0650 \u0644\u064e\u0645\u06e1 \u064a\u064e\u0637\u06e1\u0645\u0650\u062b\u06e1\u0647\u064f\u0646\u0651\u064e \u0625\u0650\u0646\u0633\u065e \u0642\u064e\u0628\u06e1\u0644\u064e\u0647\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u062c\u064e\u0627\u0653\u0646\u0651\u065e","translation":"In them are women limiting [their] glances,[1604] untouched[1605] before them by man or jinn\u012b -","footnotes":"[1604] To their own mates, i.e., being chaste and modest.\n[1605] Literally, they have not been caused to bleed by loss of virginity."},{"id":"4958","sura":"55","aya":"57","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny? -","footnotes":""},{"id":"4959","sura":"55","aya":"58","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0646\u0651\u064e \u0671\u0644\u06e1\u064a\u064e\u0627\u0642\u064f\u0648\u062a\u064f \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0631\u06e1\u062c\u064e\u0627\u0646\u064f","translation":"As if they were rubies and coral.[1606]","footnotes":"[1606] In purity, color and beauty."},{"id":"4960","sura":"55","aya":"59","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4961","sura":"55","aya":"60","arabic_text":"\u0647\u064e\u0644\u06e1 \u062c\u064e\u0632\u064e\u0627\u0653\u0621\u064f \u0671\u0644\u06e1\u0625\u0650\u062d\u06e1\u0633\u064e\u0670\u0646\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u0625\u0650\u062d\u06e1\u0633\u064e\u0670\u0646\u064f","translation":"Is the reward for good [anything] but good?","footnotes":""},{"id":"4962","sura":"55","aya":"61","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4963","sura":"55","aya":"62","arabic_text":"\u0648\u064e\u0645\u0650\u0646 \u062f\u064f\u0648\u0646\u0650\u0647\u0650\u0645\u064e\u0627 \u062c\u064e\u0646\u0651\u064e\u062a\u064e\u0627\u0646\u0650","translation":"And below them both [in excellence] are two [other] gardens -","footnotes":""},{"id":"4964","sura":"55","aya":"63","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny? -","footnotes":""},{"id":"4965","sura":"55","aya":"64","arabic_text":"\u0645\u064f\u062f\u06e1\u0647\u064e\u0627\u0653\u0645\u0651\u064e\u062a\u064e\u0627\u0646\u0650","translation":"Dark green [in color].","footnotes":""},{"id":"4966","sura":"55","aya":"65","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4967","sura":"55","aya":"66","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0645\u064e\u0627 \u0639\u064e\u064a\u06e1\u0646\u064e\u0627\u0646\u0650 \u0646\u064e\u0636\u0651\u064e\u0627\u062e\u064e\u062a\u064e\u0627\u0646\u0650","translation":"In both of them are two springs, spouting.","footnotes":""},{"id":"4968","sura":"55","aya":"67","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4969","sura":"55","aya":"68","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0645\u064e\u0627 \u0641\u064e\u0670\u0643\u0650\u0647\u064e\u0629\u065e \u0648\u064e\u0646\u064e\u062e\u06e1\u0644\u065e \u0648\u064e\u0631\u064f\u0645\u0651\u064e\u0627\u0646\u065e","translation":"In both of them are fruit and palm trees and pomegranates.","footnotes":""},{"id":"4970","sura":"55","aya":"69","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4971","sura":"55","aya":"70","arabic_text":"\u0641\u0650\u064a\u0647\u0650\u0646\u0651\u064e \u062e\u064e\u064a\u06e1\u0631\u064e\u0670\u062a\u064c \u062d\u0650\u0633\u064e\u0627\u0646\u065e","translation":"In them are good and beautiful women -","footnotes":""},{"id":"4972","sura":"55","aya":"71","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny? -","footnotes":""},{"id":"4973","sura":"55","aya":"72","arabic_text":"\u062d\u064f\u0648\u0631\u065e \u0645\u0651\u064e\u0642\u06e1\u0635\u064f\u0648\u0631\u064e\u0670\u062a\u065e \u0641\u0650\u064a \u0671\u0644\u06e1\u062e\u0650\u064a\u064e\u0627\u0645\u0650","translation":"Fair ones reserved in pavilions -","footnotes":""},{"id":"4974","sura":"55","aya":"73","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny? -","footnotes":""},{"id":"4975","sura":"55","aya":"74","arabic_text":"\u0644\u064e\u0645\u06e1 \u064a\u064e\u0637\u06e1\u0645\u0650\u062b\u06e1\u0647\u064f\u0646\u0651\u064e \u0625\u0650\u0646\u0633\u065e \u0642\u064e\u0628\u06e1\u0644\u064e\u0647\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u062c\u064e\u0627\u0653\u0646\u0651\u065e","translation":"Untouched before them by man or jinn\u012b -","footnotes":""},{"id":"4976","sura":"55","aya":"75","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny? -","footnotes":""},{"id":"4977","sura":"55","aya":"76","arabic_text":"\u0645\u064f\u062a\u0651\u064e\u0643\u0650\u0640\u0654\u0650\u064a\u0646\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0631\u064e\u0641\u06e1\u0631\u064e\u0641\u064d \u062e\u064f\u0636\u06e1\u0631\u0656 \u0648\u064e\u0639\u064e\u0628\u06e1\u0642\u064e\u0631\u0650\u064a\u0651\u064d \u062d\u0650\u0633\u064e\u0627\u0646\u0656","translation":"Reclining on green cushions and beautiful fine carpets.","footnotes":""},{"id":"4978","sura":"55","aya":"77","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"So which of the favors of your Lord would you deny?","footnotes":""},{"id":"4979","sura":"55","aya":"78","arabic_text":"\u062a\u064e\u0628\u064e\u0670\u0631\u064e\u0643\u064e \u0671\u0633\u06e1\u0645\u064f \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0630\u0650\u064a \u0671\u0644\u06e1\u062c\u064e\u0644\u064e\u0670\u0644\u0650 \u0648\u064e\u0671\u0644\u06e1\u0625\u0650\u0643\u06e1\u0631\u064e\u0627\u0645\u0650","translation":"Blessed is the name of your Lord, Owner of Majesty and Honor.","footnotes":""}]}