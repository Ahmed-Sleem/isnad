062b\u064f\u0644\u0651\u064e\u0629\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e","translation":"A company of the former peoples","footnotes":""},{"id":"5019","sura":"56","aya":"40","arabic_text":"\u0648\u064e\u062b\u064f\u0644\u0651\u064e\u0629\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u0650\u064a\u0646\u064e","translation":"And a company of the later peoples.","footnotes":""},{"id":"5020","sura":"56","aya":"41","arabic_text":"\u0648\u064e\u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u0634\u0651\u0650\u0645\u064e\u0627\u0644\u0650 \u0645\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u0634\u0651\u0650\u0645\u064e\u0627\u0644\u0650","translation":"And the companions of the left - what are the companions of the left?","footnotes":""},{"id":"5021","sura":"56","aya":"42","arabic_text":"\u0641\u0650\u064a \u0633\u064e\u0645\u064f\u0648\u0645\u0656 \u0648\u064e\u062d\u064e\u0645\u0650\u064a\u0645\u0656","translation":"[They will be] in scorching fire and scalding water","footnotes":""},{"id":"5022","sura":"56","aya":"43","arabic_text":"\u0648\u064e\u0638\u0650\u0644\u0651\u0656 \u0645\u0651\u0650\u0646 \u064a\u064e\u062d\u06e1\u0645\u064f\u0648\u0645\u0656","translation":"And a shade of black smoke,","footnotes":""},{"id":"5023","sura":"56","aya":"44","arabic_text":"\u0644\u0651\u064e\u0627 \u0628\u064e\u0627\u0631\u0650\u062f\u0656 \u0648\u064e\u0644\u064e\u0627 \u0643\u064e\u0631\u0650\u064a\u0645\u064d","translation":"Neither cool nor beneficial.","footnotes":""},{"id":"5024","sura":"56","aya":"45","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0642\u064e\u0628\u06e1\u0644\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0645\u064f\u062a\u06e1\u0631\u064e\u0641\u0650\u064a\u0646\u064e","translation":"Indeed they were, before that, indulging in affluence,","footnotes":""},{"id":"5025","sura":"56","aya":"46","arabic_text":"\u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u0635\u0650\u0631\u0651\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u062d\u0650\u0646\u062b\u0650 \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"And they used to persist in the great violation,[1612]","footnotes":"[1612] i.e., shirk (association with All\u0101h) or disbelief."},{"id":"5026","sura":"56","aya":"47","arabic_text":"\u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0623\u064e\u0626\u0650\u0630\u064e\u0627 \u0645\u0650\u062a\u06e1\u0646\u064e\u0627 \u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u062a\u064f\u0631\u064e\u0627\u0628\u0657\u0627 \u0648\u064e\u0639\u0650\u0638\u064e\u0670\u0645\u064b\u0627 \u0623\u064e\u0621\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064e\u0628\u06e1\u0639\u064f\u0648\u062b\u064f\u0648\u0646\u064e","translation":"And they used to say, \"When we die and become dust and bones, are we indeed to be resurrected?","footnotes":""},{"id":"5027","sura":"56","aya":"48","arabic_text":"\u0623\u064e\u0648\u064e\u0621\u064e\u0627\u0628\u064e\u0627\u0653\u0624\u064f\u0646\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u064f\u0648\u0646\u064e","translation":"And our forefathers [as well]?\"","footnotes":""},{"id":"5028","sura":"56","aya":"49","arabic_text":"\u0642\u064f\u0644\u06e1 \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u0650\u064a\u0646\u064e","translation":"Say, [O Mu\u1e25ammad], \"Indeed, the former and later peoples","footnotes":""},{"id":"5029","sura":"56","aya":"50","arabic_text":"\u0644\u064e\u0645\u064e\u062c\u06e1\u0645\u064f\u0648\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0645\u0650\u064a\u0642\u064e\u0670\u062a\u0650 \u064a\u064e\u0648\u06e1\u0645\u0656 \u0645\u0651\u064e\u0639\u06e1\u0644\u064f\u0648\u0645\u0656","translation":"Are to be gathered together for the appointment of a known Day.\"","footnotes":""},{"id":"5030","sura":"56","aya":"51","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0636\u0651\u064e\u0627\u0653\u0644\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"Then indeed you, O those astray [who are] deniers,","footnotes":""},{"id":"5031","sura":"56","aya":"52","arabic_text":"\u0644\u064e\u0623\u0653\u0643\u0650\u0644\u064f\u0648\u0646\u064e \u0645\u0650\u0646 \u0634\u064e\u062c\u064e\u0631\u0656 \u0645\u0651\u0650\u0646 \u0632\u064e\u0642\u0651\u064f\u0648\u0645\u0656","translation":"Will be eating from trees of zaqq\u016bm","footnotes":""},{"id":"5032","sura":"56","aya":"53","arabic_text":"\u0641\u064e\u0645\u064e\u0627\u0644\u0650\u0640\u0654\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u06e1\u0647\u064e\u0627 \u0671\u0644\u06e1\u0628\u064f\u0637\u064f\u0648\u0646\u064e","translation":"And filling with it your bellies","footnotes":""},{"id":"5033","sura":"56","aya":"54","arabic_text":"\u0641\u064e\u0634\u064e\u0670\u0631\u0650\u0628\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u0645\u0650\u064a\u0645\u0650","translation":"And drinking on top of it from scalding water","footnotes":""},{"id":"5034","sura":"56","aya":"55","arabic_text":"\u0641\u064e\u0634\u064e\u0670\u0631\u0650\u0628\u064f\u0648\u0646\u064e \u0634\u064f\u0631\u06e1\u0628\u064e \u0671\u0644\u06e1\u0647\u0650\u064a\u0645\u0650","translation":"And will drink as the drinking of thirsty camels.","footnotes":""},{"id":"5035","sura":"56","aya":"56","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u0646\u064f\u0632\u064f\u0644\u064f\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"That is their accommodation on the Day of Recompense.","footnotes":""},{"id":"5036","sura":"56","aya":"57","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064f\u0635\u064e\u062f\u0651\u0650\u0642\u064f\u0648\u0646\u064e","translation":"We have created you, so why do you not believe?","footnotes":""},{"id":"5037","sura":"56","aya":"58","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645 \u0645\u0651\u064e\u0627 \u062a\u064f\u0645\u06e1\u0646\u064f\u0648\u0646\u064e","translation":"Have you seen that which you emit?[1613]","footnotes":"[1613] i.e., semen, which contains the potential for human life."},{"id":"5038","sura":"56","aya":"59","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u062e\u06e1\u0644\u064f\u0642\u064f\u0648\u0646\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u062e\u064e\u0670\u0644\u0650\u0642\u064f\u0648\u0646\u064e","translation":"Is it you who creates it, or are We the Creator?","footnotes":""},{"id":"5039","sura":"56","aya":"60","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u0642\u064e\u062f\u0651\u064e\u0631\u06e1\u0646\u064e\u0627 \u0628\u064e\u064a\u06e1\u0646\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u062a\u064e \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0628\u0650\u0645\u064e\u0633\u06e1\u0628\u064f\u0648\u0642\u0650\u064a\u0646\u064e","translation":"We have decreed death among you, and We are not to be outdone","footnotes":""},{"id":"5040","sura":"56","aya":"61","arabic_text":"\u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0628\u064e\u062f\u0651\u0650\u0644\u064e \u0623\u064e\u0645\u06e1\u062b\u064e\u0670\u0644\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0646\u064f\u0646\u0634\u0650\u0626\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0645\u064e\u0627 \u0644\u064e\u0627 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"In that We will change your likenesses and produce you in that [form] which you do not know.[1614]","footnotes":"[1614] An alternative meaning has also been given: \"...in that We will replace the likes of you [with others upon the earth] and create you [in the Hereafter] in that which you do not know.\""},{"id":"5041","sura":"56","aya":"62","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0639\u064e\u0644\u0650\u0645\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0646\u0651\u064e\u0634\u06e1\u0623\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"And you have already known the first creation, so will you not remember?","footnotes":""},{"id":"5042","sura":"56","aya":"63","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645 \u0645\u0651\u064e\u0627 \u062a\u064e\u062d\u06e1\u0631\u064f\u062b\u064f\u0648\u0646\u064e","translation":"And have you seen that [seed] which you sow?","footnotes":""},{"id":"5043","sura":"56","aya":"64","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0632\u06e1\u0631\u064e\u0639\u064f\u0648\u0646\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u0632\u0651\u064e\u0670\u0631\u0650\u0639\u064f\u0648\u0646\u064e","translation":"Is it you who makes it grow, or are We the grower?","footnotes":""},{"id":"5044","sura":"56","aya":"65","arabic_text":"\u0644\u064e\u0648\u06e1 \u0646\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0644\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u062d\u064f\u0637\u064e\u0670\u0645\u0657\u0627 \u0641\u064e\u0638\u064e\u0644\u06e1\u062a\u064f\u0645\u06e1 \u062a\u064e\u0641\u064e\u0643\u0651\u064e\u0647\u064f\u0648\u0646\u064e","translation":"If We willed, We could make it [dry] debris, and you would remain in wonder,[1615]","footnotes":"[1615] At what had happened or remain in a state of shock. Another meaning is \"in regret.\""},{"id":"5045","sura":"56","aya":"66","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064f\u063a\u06e1\u0631\u064e\u0645\u064f\u0648\u0646\u064e","translation":"[Saying], \"Indeed, we are [now] in debt;","footnotes":""},{"id":"5046","sura":"56","aya":"67","arabic_text":"\u0628\u064e\u0644\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0645\u064e\u062d\u06e1\u0631\u064f\u0648\u0645\u064f\u0648\u0646\u064e","translation":"Rather, we have been deprived.\"","footnotes":""},{"id":"5047","sura":"56","aya":"68","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u06e1\u0645\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062a\u064e\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0646\u064e","translation":"And have you seen the water that you drink?","footnotes":""},{"id":"5048","sura":"56","aya":"69","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646\u0632\u064e\u0644\u06e1\u062a\u064f\u0645\u064f\u0648\u0647\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0632\u06e1\u0646\u0650 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u0645\u064f\u0646\u0632\u0650\u0644\u064f\u0648\u0646\u064e","translation":"Is it you who brought it down from the clouds, or is it We who bring it down?","footnotes":""},{"id":"5049","sura":"56","aya":"70","arabic_text":"\u0644\u064e\u0648\u06e1 \u0646\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u0623\u064f\u062c\u064e\u0627\u062c\u0657\u0627 \u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627 \u062a\u064e\u0634\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e","translation":"If We willed, We could make it bitter, so why are you not grateful?","footnotes":""},{"id":"5050","sura":"56","aya":"71","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u064e \u0671\u0644\u0651\u064e\u062a\u0650\u064a \u062a\u064f\u0648\u0631\u064f\u0648\u0646\u064e","translation":"And have you seen the fire that you ignite?","footnotes":""},{"id":"5051","sura":"56","aya":"72","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646\u0634\u064e\u0623\u06e1\u062a\u064f\u0645\u06e1 \u0634\u064e\u062c\u064e\u0631\u064e\u062a\u064e\u0647\u064e\u0627\u0653 \u0623\u064e\u0645\u06e1 \u0646\u064e\u062d\u06e1\u0646\u064f \u0671\u0644\u06e1\u0645\u064f\u0646\u0634\u0650\u0640\u0654\u064f\u0648\u0646\u064e","translation":"Is it you who produced its tree, or are We the producer?","footnotes":""},{"id":"5052","sura":"56","aya":"73","arabic_text":"\u0646\u064e\u062d\u06e1\u0646\u064f \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064e\u0627 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0657 \u0648\u064e\u0645\u064e\u062a\u064e\u0670\u0639\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0642\u06e1\u0648\u0650\u064a\u0646\u064e","translation":"We have made it a reminder[1616] and provision for the travelers,[1617]","footnotes":"[1616] Of the great fire of Hell.\n[1617] In the form of flints or other means by which to ignite fire. Travelers are mentioned because of the special convenience to them, although it is a provision for all people in general."},{"id":"5053","sura":"56","aya":"74","arabic_text":"\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"So exalt the name of your Lord, the Most Great.","footnotes":""},{"id":"5054","sura":"56","aya":"75","arabic_text":"\u06de\u00a0\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0645\u064e\u0648\u064e\u0670\u0642\u0650\u0639\u0650 \u0671\u0644\u0646\u0651\u064f\u062c\u064f\u0648\u0645\u0650","translation":"Then I swear by the setting of the stars,[1618]","footnotes":"[1618] All\u0101h (sub\u1e25\u0101nahu wa ta\u02bf\u0101l\u0101) confirms absolutely by oath."},{"id":"5055","sura":"56","aya":"76","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0633\u064e\u0645\u065e \u0644\u0651\u064e\u0648\u06e1 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0639\u064e\u0638\u0650\u064a\u0645\u064c","translation":"And indeed, it is an oath - if you could know - [most] great.","footnotes":""},{"id":"5056","sura":"56","aya":"77","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u065e \u0643\u064e\u0631\u0650\u064a\u0645\u065e","translation":"Indeed, it is a noble Qur\u2019\u0101n.","footnotes":""},{"id":"5057","sura":"56","aya":"78","arabic_text":"\u0641\u0650\u064a \u0643\u0650\u062a\u064e\u0670\u0628\u0656 \u0645\u0651\u064e\u0643\u06e1\u0646\u064f\u0648\u0646\u0656","translation":"In a Register well-protected;[1619].","footnotes":"[1619] The Preserved Slate (al-Law\u1e25 al-Ma\u1e25f\u016b\u1e93), which is with All\u0101h (sub\u1e25\u0101nahu wa ta\u02bf\u0101l\u0101)."},{"id":"5058","sura":"56","aya":"79","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0645\u064e\u0633\u0651\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u0637\u064e\u0647\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"None touch it except the purified [i.e., the angels].","footnotes":""},{"id":"5059","sura":"56","aya":"80","arabic_text":"\u062a\u064e\u0646\u0632\u0650\u064a\u0644\u065e \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"[It is] a revelation from the Lord of the worlds.","footnotes":""},{"id":"5060","sura":"56","aya":"81","arabic_text":"\u0623\u064e\u0641\u064e\u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u062f\u0650\u064a\u062b\u0650 \u0623\u064e\u0646\u062a\u064f\u0645 \u0645\u0651\u064f\u062f\u06e1\u0647\u0650\u0646\u064f\u0648\u0646\u064e","translation":"Then is it to this statement that you are indifferent","footnotes":""},{"id":"5061","sura":"56","aya":"82","arabic_text":"\u0648\u064e\u062a\u064e\u062c\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e \u0631\u0650\u0632\u06e1\u0642\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646\u0651\u064e\u0643\u064f\u0645\u06e1 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"And make [the thanks for] your provision that you deny [the Provider]?","footnotes":""},{"id":"5062","sura":"56","aya":"83","arabic_text":"\u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627\u0653 \u0625\u0650\u0630\u064e\u0627 \u0628\u064e\u0644\u064e\u063a\u064e\u062a\u0650 \u0671\u0644\u06e1\u062d\u064f\u0644\u06e1\u0642\u064f\u0648\u0645\u064e","translation":"Then why, when it [i.e., the soul at death] reaches the throat","footnotes":""},{"id":"5063","sura":"56","aya":"84","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u062d\u0650\u064a\u0646\u064e\u0626\u0650\u0630\u0656 \u062a\u064e\u0646\u0638\u064f\u0631\u064f\u0648\u0646\u064e","translation":"And you are at that time looking on -","footnotes":""},{"id":"5064","sura":"56","aya":"85","arabic_text":"\u0648\u064e\u0646\u064e\u062d\u06e1\u0646\u064f \u0623\u064e\u0642\u06e1\u0631\u064e\u0628\u064f \u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646 \u0644\u0651\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"And We [i.e., Our angels] are nearer to him than you, but you do not see -","footnotes":""},{"id":"5065","sura":"56","aya":"86","arabic_text":"\u0641\u064e\u0644\u064e\u0648\u06e1\u0644\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u063a\u064e\u064a\u06e1\u0631\u064e \u0645\u064e\u062f\u0650\u064a\u0646\u0650\u064a\u0646\u064e","translation":"Then why do you not, if you are not to be recompensed,","footnotes":""},{"id":"5066","sura":"56","aya":"87","arabic_text":"\u062a\u064e\u0631\u06e1\u062c\u0650\u0639\u064f\u0648\u0646\u064e\u0647\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u0635\u064e\u0670\u062f\u0650\u0642\u0650\u064a\u0646\u064e","translation":"Bring it back,[1620] if you should be truthful?","footnotes":"[1620] i.e., return the soul to the body, meaning that just as you cannot prevent death when it is decreed, you will not escape the recompense when it is decreed."},{"id":"5067","sura":"56","aya":"88","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0642\u064e\u0631\u0651\u064e\u0628\u0650\u064a\u0646\u064e","translation":"And if he [i.e., the deceased] was of those brought near [to All\u0101h],","footnotes":""},{"id":"5068","sura":"56","aya":"89","arabic_text":"\u0641\u064e\u0631\u064e\u0648\u06e1\u062d\u065e \u0648\u064e\u0631\u064e\u064a\u06e1\u062d\u064e\u0627\u0646\u065e \u0648\u064e\u062c\u064e\u0646\u0651\u064e\u062a\u064f \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"Then [for him is] rest and bounty and a garden of pleasure.","footnotes":""},{"id":"5069","sura":"56","aya":"90","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u06e1 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"And if he was of the companions of the right,","footnotes":""},{"id":"5070","sura":"56","aya":"91","arabic_text":"\u0641\u064e\u0633\u064e\u0644\u064e\u0670\u0645\u065e \u0644\u0651\u064e\u0643\u064e \u0645\u0650\u0646\u06e1 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"Then [the angels will say], \"Peace for you; [you are] from the companions of the right.\"","footnotes":""},{"id":"5071","sura":"56","aya":"92","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e \u0671\u0644\u0636\u0651\u064e\u0627\u0653\u0644\u0651\u0650\u064a\u0646\u064e","translation":"But if he was of the deniers [who were] astray,","footnotes":""},{"id":"5072","sura":"56","aya":"93","arabic_text":"\u0641\u064e\u0646\u064f\u0632\u064f\u0644\u065e \u0645\u0651\u0650\u0646\u06e1 \u062d\u064e\u0645\u0650\u064a\u0645\u0656","translation":"Then [for him is] accommodation of scalding water","footnotes":""},{"id":"5073","sura":"56","aya":"94","arabic_text":"\u0648\u064e\u062a\u064e\u0635\u06e1\u0644\u0650\u064a\u064e\u0629\u064f \u062c\u064e\u062d\u0650\u064a\u0645\u064d","translation":"And burning in Hellfire.","footnotes":""},{"id":"5074","sura":"56","aya":"95","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0647\u064e\u0670\u0630\u064e\u0627 \u0644\u064e\u0647\u064f\u0648\u064e \u062d\u064e\u0642\u0651\u064f \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u0650","translation":"Indeed, this is the true certainty,","footnotes":""},{"id":"5075","sura":"56","aya":"96","arabic_text":"\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"So exalt the name of your Lord, the Most Great.","footnotes":""}]}