es":""},{"id":"5836","sura":"82","aya":"7","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062e\u064e\u0644\u064e\u0642\u064e\u0643\u064e \u0641\u064e\u0633\u064e\u0648\u0651\u064e\u0649\u0670\u0643\u064e \u0641\u064e\u0639\u064e\u062f\u064e\u0644\u064e\u0643\u064e","translation":"Who created you, proportioned you, and balanced you?","footnotes":""},{"id":"5837","sura":"82","aya":"8","arabic_text":"\u0641\u0650\u064a\u0653 \u0623\u064e\u064a\u0651\u0650 \u0635\u064f\u0648\u0631\u064e\u0629\u0656 \u0645\u0651\u064e\u0627 \u0634\u064e\u0627\u0653\u0621\u064e \u0631\u064e\u0643\u0651\u064e\u0628\u064e\u0643\u064e","translation":"In whatever form He willed has He assembled you.","footnotes":""},{"id":"5838","sura":"82","aya":"9","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0628\u064e\u0644\u06e1 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"No! But you deny the Recompense.","footnotes":""},{"id":"5839","sura":"82","aya":"10","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u06e1 \u0644\u064e\u062d\u064e\u0670\u0641\u0650\u0638\u0650\u064a\u0646\u064e","translation":"And indeed, [appointed] over you are keepers,[1876]","footnotes":"[1876] Angels who preserve the deeds of men in records."},{"id":"5840","sura":"82","aya":"11","arabic_text":"\u0643\u0650\u0631\u064e\u0627\u0645\u0657\u0627 \u0643\u064e\u0670\u062a\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Noble and recording;","footnotes":""},{"id":"5841","sura":"82","aya":"12","arabic_text":"\u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0645\u064e\u0627 \u062a\u064e\u0641\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e","translation":"They know whatever you do.","footnotes":""},{"id":"5842","sura":"82","aya":"13","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0623\u064e\u0628\u06e1\u063